# Copy to ignored .env.beta. Production deployment means Esmeralda testnet here.
APP_ENV=production
NETWORK=esmeralda
BETA_INDEXER_URL=https://ootle-indexer-a.tari.com/
BETA_SECONDARY_INDEXER_URL=https://ootle-indexer-b.tari.com/
BETA_RECEIPT_UNLOCK_FILE=./secrets/beta-receipt.toml
BETA_REWARD_UNLOCK_FILE=./secrets/beta-reward.toml
# Resolve these before the live release; do not invent deployment identities.
PUBLIC_APP_ORIGIN=
NETWORK_INSTANCE_ID=
FUNDING_PROVIDER=public-faucet
FAUCET_ENABLED=true
FUNDING_AUTOMATION_ENABLED=false
SUBMISSIONS_ENABLED=false
ANCHORING_ENABLED=false
PAYOUTS_ENABLED=false

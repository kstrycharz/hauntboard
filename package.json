{
  "name": "hauntbox",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.18.3",
  "scripts": {
    "dev": "pnpm --filter @hauntbox/web dev --host 0.0.0.0",
    "build": "pnpm --filter @hauntbox/web build",
    "check": "pnpm --filter @hauntbox/web check",
    "test": "pnpm --filter @hauntbox/web test && pnpm test:funding",
    "test:funding": "node --test tests/funding/*.test.mjs",
    "test:e2e": "playwright test",
    "format": "prettier --write apps packages tests scripts .github *.json *.yaml *.ts",
    "format:check": "prettier --check apps packages tests scripts .github *.json *.yaml *.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.63.0",
    "@types/node": "22.18.10",
    "prettier": "3.6.2"
  },
  "dependencies": {
    "@simplewebauthn/server": "14.0.3",
    "fastify": "5.12.5",
    "jose": "6.2.12",
    "pg": "8.23.1",
    "zod": "4.6.5"
  }
}
